# Required
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...      # from @BotFather
TELEGRAM_CHAT_ID=123456789                 # from @userinfobot

# Optional
HOST_NAME=server2                          # label shown in Telegram notifications
SCAN_INTERVAL=300                          # seconds between scout scan cycles (default: 5 min)
MIN_CVSS=9.0                               # minimum CVSS to notify in real mode (default: 9.0)
BEACONRY_MAX_FINDINGS_PER_RUN=5            # per-run cap; the rest become a digest

# BC-005: scout image allowlist. Comma-separated fnmatch globs.
# Default is a demo-safe allowlist; set SCOUT_INCLUDE=* to scan everything on the host.
SCOUT_INCLUDE=nginx*,redis*,postgres*
SCOUT_EXCLUDE=                             # e.g. *-test,*-dev — leave empty for no excludes

# BC-030: internet-facing detection → Tier 1 fires. Set to 0 to disable (all
# findings fall through to Tier 2 regardless of port publication).
BEACONRY_INTERNET_FACING_DETECTION_ENABLED=1

# BC-036: digest cadence (📋 N additional finding(s) suppressed this run).
# Default: 86400s (24h) — digest fires at most once per 24h unless the
# suppressed set changes. Set to 0 to disable the throttle (pre-BC-036: one
# digest per scan). First-fire + regression notifications are UNAFFECTED.
BEACONRY_DIGEST_INTERVAL_S=86400

# BC-038: `/test/*` scenario-harness endpoints. DO NOT SET IN PRODUCTION.
# When =1 the hub registers POST /test/wipe, /test/scan, /test/sweep,
# /test/set_status which can delete findings + inject arbitrary rows.
# Enabled automatically by `make test-scenarios` in its isolated compose
# project; leave empty here so the main stack never exposes them.
BEACONRY_TEST_MODE=
