# ╭────────────────────────────────────────────────────────────────────────────╮
# │ Beaconry — operator configuration                                          │
# │ Every variable has `VAR=default`. Change only what you need to override.   │
# │ See docs/VARIABLES.md for full reason + where-read context per variable.   │
# │ `make verify-variables` fails CI if this file drifts from VARIABLES.md.    │
# ╰────────────────────────────────────────────────────────────────────────────╯

# ─── Required — Telegram credentials ───
TELEGRAM_BOT_TOKEN=<from @BotFather>              # (required) | API token; empty = Telegram no-op
TELEGRAM_CHAT_ID=<from @userinfobot>              # (required) | Chat ID; empty = Telegram no-op

# ─── Scanning behaviour ───
MIN_CVSS=7.0                                      # 7.0        | Minimum CVSS to notify (KEV bypasses)
BEACONRY_MAX_FINDINGS_PER_RUN=5                   # 5          | Per-scan cap; overflow becomes digest
SCAN_INTERVAL=300                                 # 300 (s)    | Seconds between scout scan cycles
SCOUT_HEARTBEAT_INTERVAL_S=60                     # 60  (s)    | Scout keepalive to hub (version + health); 0 = disable (BC-063)
SCOUT_INCLUDE=nginx*,redis*,postgres*             # <same>     | Comma-sep fnmatch globs; `*` = all
SCOUT_EXCLUDE=                                    # (empty)    | Blocklist overlaid on INCLUDE
HOST_NAME=                                        # <nodename> | Label in Telegram + findings DB
PACMAN_DB=/host/var/lib/pacman                    # <same>     | Arch pacman DB mount
SCOUT_HTTP_PORT=8001                              # 8001       | Scout's FastAPI health server port

# ─── Fix execution ───
BEACONRY_FIX_ENABLED=1                            # 1          | 0 = Fix buttons no-op (safe demo mode)
BEACONRY_EXECUTOR=manual                          # manual|docker | manual = log intent + remind; docker = auto-pull (BC-066)
BEACONRY_MANUAL_REMINDER_INTERVAL_S=3600          # 3600 (1h)  | Reminder cadence for manual-claimed fixes; 0 disables (BC-066)
BEACONRY_HEALTH_PROBES=                           # (empty)    | Probe DSL `image=probe;...` for verify_fix

# ─── Reconciliation & regression ───
BEACONRY_RECONCILE_ENABLED=1                      # 1          | 0 = no long-term diff / regression alerts
BEACONRY_INTERNET_FACING_DETECTION_ENABLED=1      # 1          | 0 = ignore port map; forces Tier >=2

# ─── Heartbeat reminders ───
BEACONRY_HEARTBEAT_ENABLED=1                      # 1          | 0 = no periodic reminders
BEACONRY_HEARTBEAT_INTERVAL_S=604800              # 604800 (7d)| Per-finding reminder cooldown
BEACONRY_HEARTBEAT_SWEEP_INTERVAL_S=3600          # 3600 (1h)  | How often the sweep walks the DB
BEACONRY_HEARTBEAT_LIVENESS_WINDOW_S=604800       # 604800 (7d)| Older last_seen -> no reminder

# ─── Digest cadence ───
BEACONRY_DIGEST_INTERVAL_S=86400                  # 86400 (24h)| Per-host digest cooldown; 0 = every scan
BEACONRY_DIGEST_ON_CONTENT_CHANGE=1               # 1          | 0 = hash-change bypass OFF (strict 24h); 1 = fire whenever cap tail rotates (BC-065)

# ─── BC-061 Fleet liveness windows ───
BEACONRY_FLEET_ACTIVE_WINDOW_S=600                # 600 (10m) | Scout stays "active" in /fleet STATUS if posted within this window
BEACONRY_FLEET_DEAD_AFTER_S=86400                 # 86400(24h)| Beyond this since last POST, scout is "dead"; between the two it's "stale"

# ─── BC-062 API versioning ───
BEACONRY_STRICT_API=0                             # 0          | 1 = 412 on X-Beaconry-API-Expect mismatch (strict); default soft (warn + pass)

# ─── Notification adapters ───
BEACONRY_NOTIFIER_TELEGRAM_ENABLED=1              # 1          | 0 = silence Telegram specifically

# ─── CVE feeds ───
BEACONRY_KEV_FEED_URL=                            # <CISA URL> | Override KEV feed source (air-gapped)

# ─── Paths & storage ───
DATA_DIR=/data                                    # /data      | DB + audit log + sentinel files
GRYPE_DB_CACHE_DIR=/data/grype-db                 # <none>     | Named volume for grype's 200MB DB

# ─── Hub ↔ scout wiring + remote CLI (BC-055) ───
HUB_URL=http://hub:8000                           # <same>     | scout → hub; also CLI → hub (set per-host)
HUB_TOKEN=                                        # (empty)    | client-side (scout OR cli) bearer; see HUB_*_TOKEN
HUB_SCOUT_TOKEN=                                  # (empty)    | hub-side token gating /scan (scout ingest)
HUB_CLI_TOKEN=                                    # (empty)    | hub-side token gating CLI management endpoints
HUB_PUBLISH_ADDR=127.0.0.1                        # 127.0.0.1  | 0.0.0.0 or LAN IP to expose beyond loopback
SCOUT_TRIGGER_URL=http://scout:8001/scan/trigger  # <same>     | hub /scan/trigger proxies here (compose DNS)

# ─── Developer / dev-mode (DO NOT SET IN PROD) ───
BEACONRY_MOCK=                                    # (empty)    | 1 = skip Telegram + grype DB (dev)
BEACONRY_SKIP_GRYPE_DB=                           # (derived)  | 1 = skip grype DB only (real Telegram ok)
BEACONRY_TELEGRAM_BASE_URL=                       # (empty)    | Override api.telegram.org (e2e stack)

# ─── CLI script config ───
BEACONRY_HUB_CONTAINER=beaconry-hub                # <same>     | Container `make findings` targets
BEACONRY_FINDINGS_LOCAL=                          # (empty)    | 1 = force local .beaconry-cache DB
BEACONRY_SKIP_CLI_SMOKE=                          # (empty)    | 1 = opt out of `make test-cli` live-smoke gate
